<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jade.flpt-watch</string>

    <!-- Homebrew python: the scripts use 3.10+ syntax, /usr/bin/python3 is older. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/jade/Developer/citizenship-burndown/flpt_watch.py</string>
        <string>--once</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jade/Developer/citizenship-burndown</string>

    <key>StandardOutPath</key>
    <string>/Users/jade/Developer/citizenship-burndown/flpt_watch.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jade/Developer/citizenship-burndown/flpt_watch.launchd.log</string>

    <!-- Hourly, plus once at login. A run missed during sleep fires on wake. -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/jade</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
